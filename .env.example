# Copy to .env for local runs (never commit .env). On Vercel, set these in Project Settings -> Environment Variables.

# Required for live rooms: your own X API app's Bearer Token (developer.x.com -> your app -> Keys and tokens).
# Leave empty to run without X: the radio then plays only presets you paste in.
X_BEARER_TOKEN=

# Optional daily spending caps in dollars (defaults shown). The radio stops asking X when a cap is reached
# and keeps showing the last rooms it found. Set a spending limit in the X Developer Console as well.
SPACES_RADIO_DAILY_CAP=0.60
SPACES_RADIO_CREW_SPACE_CAP=0.10
SPACES_RADIO_CREW_DAILY_CAP=0.40

# Optional: SPACES_RADIO_CREW=off hides crew names (no user lookups at all).
# SPACES_RADIO_CREW=off
